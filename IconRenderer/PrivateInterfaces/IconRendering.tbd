--- !tapi-tbd
# Link stub for the private IconRendering framework, which exists on disk
# only inside the dyld shared cache. Lists the symbols that the declarations in
# IconRendering.swiftmodule mangle to, and nothing else. To regenerate after an
# interface change, link the helper once against the copy inside Xcode's Icon
# Composer.app and list `nm -um` symbols "from IconRendering".
tbd-version:     4
targets:         [ arm64-macos, arm64e-macos ]
install-name:    '/System/Library/PrivateFrameworks/IconRendering.framework/Versions/A/IconRendering'
exports:
  - targets:         [ arm64-macos, arm64e-macos ]
    symbols:
      - '_$s13IconRendering09FinalizedA0V08renderedA04withSo10CGImageRefaSgAA19GlobalConfigurationV_tF'
      - '_$s13IconRendering09FinalizedA0V10ScaledSizeV6points5scaleAESo6CGSizeV_SitcfC'
