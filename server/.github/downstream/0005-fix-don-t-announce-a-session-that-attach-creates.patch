From 4d2379c8a28780cf08786ed264b4ab0c4570b082 Mon Sep 17 00:00:00 2001
From: Ethan Lee <ethantlee21@gmail.com>
Date: Fri, 6 Nov 2026 19:11:02 -0500
Subject: [PATCH] fix: don't announce a session that attach creates

`zmx attach` printed `session "<name>" created` and then cleared the
screen with ESC[2J, so the line was never meant to be seen. On a
terminal only a row or two tall, the line's newline scrolled it into
scrollback, which ESC[2J doesn't reach, and a terminal that then grew
pulled it back down above the session's prompt. Macterm hit this
whenever a pane was created mid split animation (thdxg/macterm#487).

Attach now creates the session silently, through the `quiet` flag that
upstream added for `zmx.create`. `zmx run` still announces it.
---
 src/client.zig          |  5 +++++
 test/attach_create.bats | 49 +++++++++++++++++++++++++++++++++++++++++
 2 files changed, 54 insertions(+)
 create mode 100644 test/attach_create.bats

diff --git a/src/client.zig b/src/client.zig
index 7248aff..a4e1f10 100644
--- a/src/client.zig
+++ b/src/client.zig
@@ -153,6 +153,11 @@ pub fn attach(alloc: Allocator, io: Io, name: []const u8, opts: AttachOptions) !
         daemon.command = opts.command;
         if (opts.cwd) |cwd| daemon.setCwd(cwd);
         if (opts.shell) |sh| daemon.shell = sh;
+        // The screen is cleared below, so announcing the new session only
+        // risks leaving the line behind: on a terminal a row or two tall its
+        // newline scrolls it into scrollback, out of the clear's reach, and a
+        // terminal that then grows shows it above the session's prompt.
+        daemon.quiet = true;
         const is_daemon_proc = try daemon.ensureSession(io);
         if (is_daemon_proc) std.process.exit(0);
     }
diff --git a/test/attach_create.bats b/test/attach_create.bats
new file mode 100644
index 0000000..9d28cd5
--- /dev/null
+++ b/test/attach_create.bats
@@ -0,0 +1,49 @@
+#!/usr/bin/env bats
+# What `zmx attach` prints when it creates the session it attaches to.
+#
+# `zmx run` announces a new session with `session "<name>" created`; `attach`
+# must not. It clears the screen right after, so the line is never meant to be
+# seen, and on a terminal one row tall its newline scrolls it into scrollback,
+# out of the clear's reach — a terminal that grows then shows it above the
+# session's prompt.
+
+load test_helper
+
+# attach_output <session> <rows> <cols>: everything `zmx attach` writes to a
+# pty of that size in its first second, as text.
+attach_output() {
+  python3 - "$ZMX" "$1" "$2" "$3" 3>&- <<'PY'
+import fcntl, os, pty, signal, struct, sys, termios, time
+zmx, name, rows, cols = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
+pid, fd = pty.fork()
+if pid == 0:
+    fcntl.ioctl(0, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))
+    os.execve(zmx, [zmx, "attach", name, "/bin/sh"], os.environ)
+out, end = b"", time.time() + 1
+os.set_blocking(fd, False)
+while time.time() < end:
+    try:
+        out += os.read(fd, 65536)
+    except (BlockingIOError, OSError):
+        time.sleep(0.05)
+os.kill(pid, signal.SIGKILL)
+os.waitpid(pid, 0)
+sys.stdout.write(out.decode(errors="replace"))
+PY
+}
+
+@test "attach: creating the session prints no announcement" {
+  command -v python3 >/dev/null || skip "python3 needed to allocate a test PTY"
+  run attach_output test-attach-quiet 1 80
+  [ "$status" -eq 0 ]
+  # The attach really happened: its clear reached the terminal.
+  [[ "$output" == *$'\e[2J'* ]]
+  [[ "$output" != *"created"* ]]
+  wait_for_session test-attach-quiet
+}
+
+@test "run: creating the session still announces it" {
+  run "$ZMX" run test-run-announce -d echo hello
+  [ "$status" -eq 0 ]
+  [[ "$output" == *"session \"test-run-announce\" created"* ]]
+}
