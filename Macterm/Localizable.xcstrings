    "You already have a palette named %@." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@(이)라는 이름의 팔레트가 이미 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已有名为 %@ 的面板。"
          }
        }
      }
    },
    "You can set Macterm as the default app to open text files from Finder. It opens them in the editor that $VISUAL or $EDITOR names in your shell." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder에서 텍스트 파일을 여는 기본 앱으로 Macterm을 설정할 수 있습니다. Macterm은 셸의 $VISUAL 또는 $EDITOR가 지정하는 편집기에서 파일을 엽니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以将 Macterm 设为从“访达”打开文本文件的默认 App。Macterm 会在 shell 中 $VISUAL 或 $EDITOR 指定的编辑器中打开它们。"
          }
        }
      }
    },
    "You changed %@. Your changed copy goes to the Trash." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 변경했습니다. 변경한 사본은 휴지통으로 이동합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已更改 %@。你更改过的副本将移到废纸篓。"
          }
        }
      }
    },
    "Your Ghostty config asks for notifications." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghostty 설정이 알림을 요청합니다."
