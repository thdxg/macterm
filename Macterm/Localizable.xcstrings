{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" is not a key combination. Try ctrl+c, escape or up." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”은(는) 키 조합이 아닙니다. ctrl+c, escape 또는 up을 사용해 보십시오."
          }
        }
      }
    },
    "\"%@\" is not an action in %@ now." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%1$@\" is not an action in %2$@ now."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”은(는) 현재 %2$@의 동작이 아닙니다."
          }
        }
      }
    },
    "%@" : {
      "shouldTranslate" : false
    },
    "%@\n\nPinned-tab auto-save is paused so your edits are not overwritten. Fix the file, or delete it, to start auto-save again." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n편집한 내용을 덮어쓰지 않도록 고정된 탭 자동 저장을 일시 정지했습니다. 자동 저장을 다시 시작하려면 파일을 수정하거나 삭제하십시오."
          }
        }
      }
    },
    "%@\n\nWidget auto-save is paused so your edits are not overwritten. Fix the file, or delete it, to start auto-save again." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\n편집한 내용을 덮어쓰지 않도록 위젯 자동 저장을 일시 정지했습니다. 자동 저장을 다시 시작하려면 파일을 수정하거나 삭제하십시오."
          }
        }
      }
    },
    "%@ Blocked This Link" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 이 링크를 차단함"
          }
        }
      }
    },
    "%@ and %@ will be deleted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ and %2$@ will be deleted."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 및 %@이(가) 삭제됩니다."
          }
        }
      }
    },
    "%@ cannot find that item now." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 지금 해당 항목을 찾을 수 없습니다."
          }
        }
      }
    },
    "%@ does not allow Shortcuts. Set macos-shortcuts = allow in your Ghostty config." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 단축어를 허용하지 않습니다. Ghostty 설정에서 macos-shortcuts = allow를 설정하십시오."
          }
        }
      }
    },
    "%@ is missing the `path: %@` marker. Macterm does not touch it" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is missing the `path: %2$@` marker. Macterm does not touch it"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 `path: %@` 표시가 없습니다. Macterm은 이 파일을 변경하지 않습니다"
          }
        }
      }
    },
    "%@ is not available" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 사용할 수 없음"
          }
        }
      }
    },
    "%@ is not installed." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 설치되어 있지 않습니다."
          }
        }
      }
    },
    "%@ is not ready yet." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 아직 준비되지 않았습니다."
          }
        }
      }
    },
    "%@ is not valid YAML: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is not valid YAML: %2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 올바른 YAML이 아닙니다: %@"
          }
        }
      }
    },
    "%@ is not valid: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is not valid: %2$@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 올바르지 않습니다: %@"
          }
        }
      }
    },
    "%@ palette" : {
      "comment" : "A feature of an extension, named in the prompt to uninstall it",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 팔레트"
          }
        }
      }
    },
    "%@ share this folder and the layout file “%@” with this project. Your save replaced their layout. Each save replaces the one before. Give the projects different names to keep separate layout files." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ share this folder and the layout file “%2$@” with this project. Your save replaced their layout. Each save replaces the one before. Give the projects different names to keep separate layout files."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 프로젝트가 이 프로젝트와 폴더 및 레이아웃 파일 “%2$@”을(를) 공유합니다. 저장하면서 해당 프로젝트의 레이아웃을 대체했습니다. 저장할 때마다 이전 레이아웃이 대체됩니다. 레이아웃 파일을 따로 유지하려면 프로젝트 이름을 다르게 지정하십시오."
          }
        }
      }
    },
    "%@ will be deleted." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 삭제됩니다."
          }
        }
      }
    },
    "%@ — %lld tabs" : {
      "comment" : "Settings → Layouts: a layout file's path and tab count",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ — %2$lld tabs"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 탭 %lld개"
          }
        }
      }
    },
    "%@ — 1 tab" : {
      "comment" : "Settings → Layouts: a layout file's path and tab count",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 탭 1개"
          }
        }
      }
    },
    "%@ — any command" : {
      "comment" : "Command palette, Password Manager: a saved password that answers its prompt for every command",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 모든 명령"
          }
        }
      }
    },
    "%@ — no tabs" : {
      "comment" : "Settings → Layouts: a layout file's path and tab count",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — 탭 없음"
          }
        }
      }
    },
    "%@, %@, and %lld more features will be deleted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@, and %3$lld more features will be deleted."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@ 및 기능 %lld개가 더 삭제됩니다."
          }
        }
      }
    },
    "%@, %@, and 1 more feature will be deleted." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@, and 1 more feature will be deleted."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@ 및 기능 1개가 더 삭제됩니다."
          }
        }
      }
    },
    "%@s" : {
      "comment" : "A duration in seconds, as in 4.2s",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@초"
          }
        }
      }
    },
    "%lld panes" : {
      "comment" : "Sidebar title of a tab with four or more panes",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페인 %lld개"
          }
        }
      }
    },
    "%lld processes are still running. Quit anyway?" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로세스 %lld개가 아직 실행 중입니다. 그래도 종료하시겠습니까?"
          }
        }
      }
    },
    "%lldh %lldm" : {
      "comment" : "A duration in hours and minutes, as in 2h 5m",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lldh %2$lldm"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld시간 %lld분"
          }
        }
      }
    },
    "%lldm %llds" : {
      "comment" : "A duration in minutes and seconds, as in 3m 20s",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lldm %2$llds"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld분 %lld초"
          }
        }
      }
    },
    "1 process is still running. Quit anyway?" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로세스 1개가 아직 실행 중입니다. 그래도 종료하시겠습니까?"
          }
        }
      }
    },
    "A build of every commit that passes CI, and stable releases. Tip builds get no release tests." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CI를 통과한 모든 커밋의 빌드와 안정 버전을 받습니다. Tip 빌드는 릴리스 테스트를 거치지 않습니다."
          }
        }
      }
    },
    "A fading streak follows the cursor on larger moves." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커서가 크게 이동하면 사라지는 자취가 따라갑니다."
          }
        }
      }
    },
    "A key combination such as ctrl+c, escape or up, or a single printable key such as j." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ctrl+c, escape 또는 up 같은 키 조합, 또는 j 같은 출력 가능한 키 하나입니다."
          }
        }
      }
    },
    "A keybind with Pass to TUI selected goes to these programs. The action does not run. Separate the names with commas." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TUI로 전달이 선택된 단축키는 이 프로그램으로 전달됩니다. 동작은 실행되지 않습니다. 이름은 쉼표로 구분하십시오."
          }
        }
      }
    },
    "A pane there has a running program. Close it in %@ instead." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 위치의 페인에서 프로그램이 실행 중입니다. 대신 %@에서 닫으십시오."
          }
        }
      }
    },
    "A password is already saved for that command and prompt." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 명령과 프롬프트에 대한 암호가 이미 저장되어 있습니다."
          }
        }
      }
    },
    "A password is saved for this prompt." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프롬프트에 대해 저장된 암호가 있습니다."
          }
        }
      }
    },
    "A process is still running in one of the selected items. Removing them ends every process in their tabs." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 항목 중 하나에서 프로세스가 아직 실행 중입니다. 제거하면 탭의 모든 프로세스가 종료됩니다."
          }
        }
      }
    },
    "A process is still running in this pane. Close the pane anyway?" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 페인에서 프로세스가 아직 실행 중입니다. 그래도 페인을 닫으시겠습니까?"
          }
        }
      }
    },
    "A process is still running in this project. Removing it ends every process in its tabs." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로젝트에서 프로세스가 아직 실행 중입니다. 제거하면 탭의 모든 프로세스가 종료됩니다."
          }
        }
      }
    },
    "A process is still running in this project. Unloading ends every process in its tabs. Macterm keeps the layout." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로젝트에서 프로세스가 아직 실행 중입니다. 언로드하면 탭의 모든 프로세스가 종료됩니다. Macterm은 레이아웃을 유지합니다."
          }
        }
      }
    },
    "A process is still running in this tab. Closing the tab ends it." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 탭에서 프로세스가 아직 실행 중입니다. 탭을 닫으면 프로세스가 종료됩니다."
          }
        }
      }
    },
    "A process is still running in this widget. Remove the widget anyway?" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 위젯에서 프로세스가 아직 실행 중입니다. 그래도 위젯을 제거하시겠습니까?"
          }
        }
      }
    },
    "A remote project cannot open a directory on this Mac" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원격 프로젝트는 이 Mac의 디렉토리를 열 수 없습니다"
          }
        }
      }
    },
    "A shortcut wants to run an action in %@. It can create projects and tabs. It can also type into your terminals." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축어가 %@에서 동작을 실행하려고 합니다. 단축어는 프로젝트와 탭을 만들 수 있습니다. 터미널에 입력할 수도 있습니다."
          }
        }
      }
    },
    "A terminal program wants to replace your clipboard with:\n\n%@" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 프로그램이 클립보드의 내용을 다음으로 바꾸려고 합니다:\n\n%@"
          }
        }
      }
    },
    "A widget is a terminal on your desktop." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위젯은 데스크탑에 있는 터미널입니다."
          }
        }
      }
    },
    "Action" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동작"
          }
        }
      }
    },
    "Adaptive background" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "적응형 배경"
          }
        }
      }
    },
    "Add" : {
      "comment" : "Settings → General: the button of the open panel that adds Ghostty config files",
