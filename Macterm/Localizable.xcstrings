    },
    "The keys that move the cursor and select text in copy mode. A change applies the next time the mode starts." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복사 모드에서 커서를 이동하고 텍스트를 선택하는 키입니다. 변경 사항은 다음에 모드를 시작할 때 적용됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
