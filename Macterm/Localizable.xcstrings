      }
    },
    "Macterm could not save the password." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macterm이 암호를 저장할 수 없습니다."
          }
        }
      }
    },
    "Macterm could not write the capture as a PNG." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macterm이 캡처를 PNG로 저장하지 못했습니다."
          }
        }
      }
    },
    "Macterm deletes “%@”. The projects that use it stay, but they lose their saved layout." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macterm이 “%@”을(를) 삭제합니다. 이 파일을 사용하는 프로젝트는 유지되지만 저장된 레이아웃을 잃습니다."
          }
        }
      }
    },
    "Macterm has no notification permission" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macterm에 알림 권한이 없음"
          }
        }
      }
    },
    "Macterm is already writing %@." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macterm이 이미 %@에 쓰는 중입니다."
          }
        }
      }
    },
    "Macterm loads the files from top to bottom. A later file overrides an earlier file." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macterm은 위에서 아래 순서로 파일을 불러옵니다. 뒤에 있는 파일이 앞에 있는 파일보다 우선합니다."
          }
        }
      }
    },
    "Macterm offers Autofill when both the command and the prompt match. With no prompt, Macterm never offers the password at a prompt. Select it in Password Manager in the command palette." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "명령과 프롬프트가 모두 일치하면 Macterm이 자동 완성을 제안합니다. 프롬프트가 없으면 Macterm은 프롬프트에서 암호를 제안하지 않습니다. 명령 팔레트의 암호 관리자에서 선택하십시오."
          }
        }
      }
    },
    "Macterm removes the password for “%@” from your keychain." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macterm이 키체인에서 “%@”의 암호를 제거합니다."
          }
        }
      }
    },
    "Macterm saved the layout to “%@”. These other files also declare the path of this project, and Macterm ignores them: %@. Remove them or merge them in the projects folder." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Macterm saved the layout to “%1$@”. These other files also declare the path of this project, and Macterm ignores them: %2$@. Remove them or merge them in the projects folder."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macterm이 레이아웃을 “%1$@”에 저장했습니다. 다음 파일도 이 프로젝트의 경로를 선언하며, Macterm은 이 파일을 무시합니다: %2$@. 프로젝트 폴더에서 이 파일을 제거하거나 병합하십시오."
          }
        }
      }
    },
    "Macterm saves a key passphrase from its prompt. Type it there one time and save it." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macterm은 키 암호문을 해당 프롬프트에서 저장합니다. 프롬프트에 한 번 입력하고 저장하십시오."
          }
        }
      }
    },
    "Macterm types this into the shell of the new tab when the shell starts. Leave it empty for a plain shell." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸이 시작될 때 Macterm이 새로운 탭의 셸에 이 내용을 입력합니다. 일반 셸을 사용하려면 비워 두십시오."
          }
        }
      }
    },
    "Macterm updated to v%@" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macterm이 v%@(으)로 업데이트되었습니다"
