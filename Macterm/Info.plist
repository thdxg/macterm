<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<!-- Follows PRODUCT_NAME, which is config-dependent: Debug builds the
	     bundle as "Macterm Debug.app" (with a matching executable) so the Dock
	     tile, Cmd-Tab and Finder label it "Macterm Debug" — all three read the
	     bundle's filename and ignore CFBundleDisplayName. -->
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_DISPLAY_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>$(PRODUCT_DISPLAY_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>GitCommit</key>
	<string>$(GIT_COMMIT)</string>
	<key>MactermUpdateChannel</key>
	<string>$(MACTERM_UPDATE_CHANNEL)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<!-- Finder's "Open With", a drop on the Dock icon and `open -a Macterm`
	     all deliver a document, which AppDelegate.application(_:open:) turns
	     into a project (a folder) or the user's terminal editor (a file).
	     Every entry is Alternate rank, so Macterm is never a default opener
	     until the user picks it with Get Info > Open with > Change All.
	     Text files are public.text, which covers every type macOS knows is
	     text (source code, scripts, JSON, YAML, Markdown); the extension list
	     names common ones it doesn't know, which it would otherwise type as
	     plain data (go, rs) or not text at all (ts, a video format) - the same
	     split Zed's Info.plist makes. Folders mirror Ghostty's entry. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folders</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.directory</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Text Files</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.text</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Source Files</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>go</string>
				<string>rs</string>
				<string>zig</string>
				<string>ts</string>
				<string>cts</string>
				<string>jsx</string>
				<string>cjs</string>
				<string>kt</string>
				<string>kts</string>
				<string>lua</string>
				<string>nu</string>
				<string>fish</string>
				<string>conf</string>
				<string>lock</string>
				<string>env</string>
				<string>ex</string>
				<string>exs</string>
				<string>erb</string>
				<string>heex</string>
				<string>scala</string>
				<string>dart</string>
				<string>vue</string>
				<string>svelte</string>
				<string>astro</string>
				<string>hcl</string>
				<string>tf</string>
				<string>tfvars</string>
				<string>graphql</string>
				<string>gql</string>
				<string>nix</string>
				<string>elm</string>
				<string>clj</string>
				<string>cljs</string>
				<string>hs</string>
				<string>ml</string>
				<string>mli</string>
				<string>gleam</string>
				<string>sol</string>
				<string>cue</string>
				<string>jsonc</string>
				<string>json5</string>
				<string>gradle</string>
				<string>groovy</string>
				<string>cmake</string>
				<string>rst</string>
				<string>adoc</string>
				<string>org</string>
				<string>tex</string>
				<string>bib</string>
				<string>vim</string>
				<string>el</string>
				<string>rkt</string>
				<string>scm</string>
				<string>lisp</string>
				<string>jl</string>
				<string>ps1</string>
				<string>bat</string>
				<string>cs</string>
				<string>fsx</string>
				<string>vb</string>
				<string>tcl</string>
				<string>awk</string>
				<string>sed</string>
				<string>mdx</string>
				<string>properties</string>
				<string>editorconfig</string>
				<string>gitignore</string>
				<string>gitattributes</string>
				<string>dockerignore</string>
				<string>npmrc</string>
			</array>
		</dict>
	</array>
	<!-- Spotlight keyword, so "Terminal" finds the app (as Ghostty does). -->
	<key>MDItemKeywords</key>
	<string>Terminal</string>
<key>NSAppleEventsUsageDescription</key>
	<string>A program in a Macterm terminal wants to use AppleScript.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>A program in a Macterm terminal wants to use Bluetooth.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>A program in a Macterm terminal wants to access your calendar.</string>
	<key>NSCameraUsageDescription</key>
	<string>A program in a Macterm terminal wants to use the camera.</string>
	<key>NSContactsUsageDescription</key>
	<string>A program in a Macterm terminal wants to access your contacts.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>A program in a Macterm terminal wants to access the local network.</string>
	<key>NSLocationUsageDescription</key>
	<string>A program in a Macterm terminal wants to access your location information.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>A program in a Macterm terminal wants to use your microphone.</string>
	<key>NSMotionUsageDescription</key>
	<string>A program in a Macterm terminal wants to access motion data.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>A program in a Macterm terminal wants to access your photo library.</string>
	<key>NSRemindersUsageDescription</key>
	<string>A program in a Macterm terminal wants to access your reminders.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>A program in a Macterm terminal wants to use speech recognition.</string>
	<key>NSSystemAdministrationUsageDescription</key>
	<string>A program in a Macterm terminal needs elevated privileges.</string>
	<key>SUFeedURL</key>
	<string>https://macterm.thdxg.dev/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>$(SPARKLE_ED_PUBLIC_KEY)</string>
	<key>SUEnableInstallerLauncherService</key>
	<false/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
	<key>SUAllowsAutomaticUpdates</key>
	<true/>
	<!-- Finder's Services menu (right-click a folder → Services). The label
	     follows the display name so the Debug app registers its own item
	     beside the release one instead of colliding with it. NSMessage names
	     the @objc method on FinderServiceProvider; the send types and
	     required context mirror Ghostty's "New Ghostty Tab Here" entry. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>New $(PRODUCT_DISPLAY_NAME) Project Here</string>
			</dict>
			<key>NSMessage</key>
			<string>newProjectHere</string>
			<key>NSRequiredContext</key>
			<dict>
				<key>NSTextContent</key>
				<string>FilePath</string>
			</dict>
			<key>NSSendTypes</key>
			<array>
				<string>NSFilenamesPboardType</string>
				<string>public.plain-text</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.thdxg.macterm.pane-id</string>
			<key>UTTypeDescription</key>
			<string>Macterm Pane Identifier</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict/>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.thdxg.macterm.tab-move</string>
			<key>UTTypeDescription</key>
			<string>Macterm Tab Move</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict/>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.thdxg.macterm.project-move</string>
			<key>UTTypeDescription</key>
			<string>Macterm Project Move</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict/>
		</dict>
	</array>
</dict>
</plist>
