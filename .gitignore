.DS_Store
.claude/
.codegraph/

# Ghostty resources downloaded by setup.sh from the thdxg/ghostty release,
# mirroring a real Ghostty.app layout
GhosttyKit.xcframework
Macterm/Resources/*
!Macterm/Resources/.gitkeep
# Records which pinned release the two artifacts above came from, so bumping
# GHOSTTYKIT_TAG in setup.sh refreshes them instead of the presence checks
# silently keeping the old copy. Per-checkout state, not source.
.ghosttykit-tag

build/
__pycache__/
.pytest_cache/

# Generated by xcodegen from project.yml
Macterm.xcodeproj/


# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example
